datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id_usuario      Int          @id @default(autoincrement())
  nome            String
  email           String       @unique
  senha           String
  perfil          String       @default("Analista P&D")
  iniciativas     Iniciativa[] @relation("UsuarioResponsavel")

  @@map("usuario")
}

model Iniciativa {
  id_iniciativa          Int          @id @default(autoincrement())
  codigo                 String       @unique
  nome                   String
  descricao              String?      @db.Text
  classificacao_pd       String
  score_trl              Int
  elegibilidade_pct      Decimal      @db.Decimal(5, 2)
  risco_glosa            String
  barreira_incerteza     String?      @db.Text
  cnae                   String?
  data_inicio            DateTime?    @db.Date
  data_fim               DateTime?    @db.Date
  status                 String       @default("Em Avaliação")
  criado_em              DateTime     @default(now())
  atualizado_em          DateTime     @updatedAt
  
  usuario_responsavel_id Int
  usuario_responsavel    Usuario      @relation("UsuarioResponsavel", fields: [usuario_responsavel_id], references: [id_usuario])
  
  marcos                 MarcoExperimento[]
  dispendios             Dispendio[]
  timesheets             Timesheet[]

  @@map("iniciativa")
}

model MarcoExperimento {
  id_marco         Int        @id @default(autoincrement())
  iniciativa_id    Int
  iniciativa       Iniciativa @relation(fields: [iniciativa_id], references: [id_iniciativa], onDelete: Cascade)
  titulo           String
  periodo          String
  descricao        String     @db.Text
  status_validacao String     @default("Validado")
  hash_evidencia   String?
  tamanho_arquivo  String?

  @@map("marco_experimento")
}

model Dispendio {
  id_dispendio            Int        @id @default(autoincrement())
  iniciativa_id           Int
  iniciativa              Iniciativa @relation(fields: [iniciativa_id], references: [id_iniciativa], onDelete: Cascade)
  descricao               String     @db.Text
  valor                   Decimal    @db.Decimal(12, 2)
  data                    DateTime   @db.Date
  categoria               String
  documento_comprobatorio String?

  @@map("dispendio")
}

model Timesheet {
  id_timesheet     Int        @id @default(autoincrement())
  colaborador_id   String
  colaborador_nome String
  cargo_regime     String
  iniciativa_id    Int
  iniciativa       Iniciativa @relation(fields: [iniciativa_id], references: [id_iniciativa], onDelete: Cascade)
  data             DateTime   @db.Date
  horas_mes        Int
  elegivel_pct     Decimal    @db.Decimal(5, 2)
  custo_apropriado Decimal    @db.Decimal(10, 2)
  status           String     @default("Aprovado pelo Gestor")

  @@map("timesheet")
}